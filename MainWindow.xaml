<Window x:Class="Mint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mint Launcher" Width="760" Height="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        AllowDrop="True"
        Drop="Window_Drop"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Apps List & Quick Search -->
        <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <Border Grid.Row="0" Background="{DynamicResource InputBg}" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10">
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtSearch" Grid.Column="1" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="{DynamicResource TextPrimary}" 
                                 FontSize="13" 
                                 VerticalAlignment="Center"
                                 TextChanged="TxtSearch_TextChanged"
                                 KeyDown="TxtSearch_KeyDown"/>
                    </Grid>
                </Border>

                <!-- Group Filter Buttons -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                    <StackPanel x:Name="PanelGroups" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- Apps List -->
                <ListBox Grid.Row="2" x:Name="LstApps"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewKeyDown="LstApps_PreviewKeyDown"
                         MouseDoubleClick="LstApps_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Background="{DynamicResource InputBg}" CornerRadius="8" Padding="10,8" Margin="0,2" Cursor="Hand">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Launch" Click="MenuLaunch_Click"/>
                                        <MenuItem Header="Run as Administrator" Click="MenuRunAsAdmin_Click"/>
                                        <MenuItem Header="Open Location" Click="MenuOpenLocation_Click"/>
                                        <Separator Background="{DynamicResource BorderColor}"/>
                                        <MenuItem Header="Edit" Click="MenuEdit_Click"/>
                                        <MenuItem Header="Delete" Click="MenuDelete_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding App.AppTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding App.AppGroup}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="↵" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBg}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock x:Name="TxtFooterCount" Text="0 Apps" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="Double-click or Enter to launch" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Right Panel: App Configuration & Themes -->
        <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="App Configuration" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                    <TextBlock Text="App Title" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,2"/>
                    <TextBox x:Name="TxtTitle" Height="28"/>

                    <TextBlock Text="Target / Exe Path" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPath" Grid.Column="0" Height="28"/>
                        <Button Grid.Column="2" Content="..." Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand" Click="BtnBrowseTarget_Click"/>
                    </Grid>

                    <TextBlock Text="Arguments (optional)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,2"/>
                    <TextBox x:Name="TxtArgs" Height="28"/>

                    <TextBlock Text="Category / Group (optional)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,2"/>
                    <TextBox x:Name="TxtGroup" Height="28"/>

                    <TextBlock Text="Custom Icon Path (optional)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCustomIcon" Grid.Column="0" Height="28"/>
                        <Button Grid.Column="2" Content="..." Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand" Click="BtnBrowseIcon_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Clear" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextSecondary}" Padding="12,4" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" Click="BtnClear_Click"/>
                        <Button x:Name="BtnSave" Content="Save App" Background="{DynamicResource AccentColor}" Foreground="White" FontWeight="SemiBold" Padding="14,4" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
                    </StackPanel>

                    <Separator Background="{DynamicResource BorderColor}" Margin="0,16"/>

                    <!-- Preferences -->
                    <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbSystem" Content="System" Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0" Checked="RbTheme_Checked"/>
                        <RadioButton x:Name="RbDark" Content="Dark" Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0" Checked="RbTheme_Checked"/>
                        <RadioButton x:Name="RbLight" Content="Light" Foreground="{DynamicResource TextSecondary}" Checked="RbTheme_Checked"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkAutoStart" Content="Start with Windows" Foreground="{DynamicResource TextSecondary}" Click="ChkAutoStart_Click"/>

                    <TextBlock Text="Tip: Closing this window will minimize Mint to the system tray near your clock." 
                               Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
