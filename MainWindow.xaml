<Window x:Class="Mint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mint" Width="380" Height="530"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Deactivated="Window_Deactivated"
        AllowDrop="True"
        Drop="Window_Drop">

    <Border Background="{DynamicResource FlyoutBg}" 
            BorderBrush="{DynamicResource BorderColor}" 
            BorderThickness="1" 
            CornerRadius="12" 
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Direction="270"/>
        </Border.Effect>

        <Grid>
            <!-- View 1: Main Launcher Flyout -->
            <Grid x:Name="ViewLauncher" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: Logo, Search Bar & Settings Button -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource InputBg}" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <Grid Margin="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="{DynamicResource TextPrimary}" 
                                     FontSize="13" 
                                     VerticalAlignment="Center"
                                     TextChanged="TxtSearch_TextChanged"
                                     KeyDown="TxtSearch_KeyDown"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Content="⚙" FontSize="14" 
                            Background="{DynamicResource CardBg}" 
                            Foreground="{DynamicResource TextPrimary}" 
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="BtnOpenSettings_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Groups Filter Bar -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,6">
                    <StackPanel x:Name="PanelGroups" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- Apps List -->
                <ListBox Grid.Row="2" x:Name="LstApps"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewKeyDown="LstApps_PreviewKeyDown"
                         MouseDoubleClick="LstApps_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="10,8" Margin="0,2" Cursor="Hand">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Run as Administrator" Click="MenuRunAsAdmin_Click"/>
                                        <MenuItem Header="Open File Location" Click="MenuOpenLocation_Click"/>
                                        <Separator Background="{DynamicResource BorderColor}"/>
                                        <MenuItem Header="Edit" Click="MenuEdit_Click"/>
                                        <MenuItem Header="Remove" Click="MenuDelete_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding App.AppTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding App.AppGroup}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="↵" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBg}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer: Status & Exit -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock x:Name="TxtFooterCount" Text="0 Apps" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    <Button Content="Quit" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnExit_Click"/>
                </Grid>
            </Grid>

            <!-- View 2: Slide-in Configuration / Settings Drawer -->
            <Grid x:Name="ViewSettings" Visibility="Collapsed" Margin="14" Background="{DynamicResource FlyoutBg}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Back Button -->
                        <Button Content="← Back to Launcher" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,12" Click="BtnBackToLauncher_Click"/>

                        <TextBlock Text="Add / Edit App" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <TextBlock Text="Title" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,2"/>
                        <TextBox x:Name="TxtTitle" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" Padding="6" Height="28"/>

                        <TextBlock Text="Target / Exe Path" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPath" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" Padding="6" Height="28"/>
                            <Button Grid.Column="2" Content="..." Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" Click="BtnBrowseTarget_Click"/>
                        </Grid>

                        <TextBlock Text="Parameters" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,2"/>
                        <TextBox x:Name="TxtArgs" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" Padding="6" Height="28"/>

                        <TextBlock Text="Group" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,2"/>
                        <TextBox x:Name="TxtGroup" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" Padding="6" Height="28"/>

                        <TextBlock Text="Custom Icon (optional)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCustomIcon" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" Padding="6" Height="28"/>
                            <Button Grid.Column="2" Content="..." Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" Click="BtnBrowseIcon_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="Clear" Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextSecondary}" Padding="10,4" Margin="0,0,6,0" BorderThickness="0" Click="BtnClear_Click"/>
                            <Button x:Name="BtnSave" Content="Save" Background="{DynamicResource AccentColor}" Foreground="White" Padding="14,4" BorderThickness="0" Click="BtnSave_Click"/>
                        </StackPanel>

                        <Separator Background="{DynamicResource BorderColor}" Margin="0,14"/>

                        <!-- Modern Theming Options -->
                        <TextBlock Text="Theme Preference" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="RbSystem" Content="System" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0" Checked="RbTheme_Checked"/>
                            <RadioButton x:Name="RbDark" Content="Dark" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0" Checked="RbTheme_Checked"/>
                            <RadioButton x:Name="RbLight" Content="Light" Foreground="{DynamicResource TextSecondary}" Checked="RbTheme_Checked"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkAutoStart" Content="Launch with Windows" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14" Click="ChkAutoStart_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
