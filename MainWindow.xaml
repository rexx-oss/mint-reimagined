<Window x:Class="Mint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mint" Height="640" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        ResizeMode="CanMinimize"
        AllowDrop="True"
        Drop="Window_Drop"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Configuration & Settings -->
        <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="App Configuration" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                    <TextBlock Text="Title" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,2"/>
                    <TextBox x:Name="TxtTitle"/>

                    <TextBlock Text="Target Location / Exe" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPath" Grid.Column="0"/>
                        <Button Content="..." Grid.Column="2" Click="BtnBrowseTarget_Click"/>
                    </Grid>

                    <TextBlock Text="Arguments (optional)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,2"/>
                    <TextBox x:Name="TxtArgs"/>

                    <TextBlock Text="Group (optional)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,2"/>
                    <ComboBox x:Name="CmbGroups" IsEditable="True" Height="30"/>

                    <TextBlock Text="Custom Icon (optional)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtIcon" Grid.Column="0"/>
                        <Button Content="..." Grid.Column="2" Click="BtnBrowseIcon_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Clear" Background="#71717A" Margin="0,0,8,0" Click="BtnClear_Click"/>
                        <Button x:Name="BtnSave" Content="Add / Save" Click="BtnSave_Click"/>
                    </StackPanel>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,16"/>

                    <!-- Modern Theme Options -->
                    <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="RbSystem" Content="System" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0" Checked="RbTheme_Checked"/>
                        <RadioButton x:Name="RbDark" Content="Dark" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0" Checked="RbTheme_Checked"/>
                        <RadioButton x:Name="RbLight" Content="Light" Foreground="{DynamicResource TextSecondary}" Checked="RbTheme_Checked"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkAutoStart" Content="Start with Windows" Foreground="{DynamicResource TextSecondary}" Click="ChkAutoStart_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right: App List & Search -->
        <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TxtListHeader" Text="Apps" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>

                <TextBox Grid.Row="1" x:Name="TxtSearch" Margin="0,0,0,10" Padding="6" TextChanged="TxtSearch_TextChanged" ToolTip="Search apps..."/>

                <ListBox Grid.Row="2" x:Name="LstApps"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}"
                         PreviewMouseLeftButtonDown="LstApps_PreviewMouseLeftButtonDown"
                         MouseMove="LstApps_MouseMove"
                         Drop="LstApps_Drop"
                         AllowDrop="True"
                         MouseDoubleClick="LstApps_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,4" CornerRadius="4" Background="{DynamicResource InputBrush}" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding App.AppTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding App.AppGroup}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="↑" Padding="6,2" Margin="2,0" Background="#52525B" Click="BtnUp_Click"/>
                                        <Button Content="↓" Padding="6,2" Margin="2,0" Background="#52525B" Click="BtnDown_Click"/>
                                        <Button Content="✕" Padding="6,2" Margin="2,0" Background="#EF4444" Click="BtnDelete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" Text="Tip: Double-click to launch or edit. Drag to reorder. Minimize to send to tray." 
                           Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>