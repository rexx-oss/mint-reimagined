<Window x:Class="Mint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mint Launcher" Width="900" Height="600"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        AllowDrop="True"
        Drop="Window_Drop"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <!-- 3 Parts Left: App List / Navigation Sidebar (~43%) -->
            <ColumnDefinition Width="3*" MinWidth="300"/>
            
            <!-- Clean 16px Spacing -->
            <ColumnDefinition Width="16"/>
            
            <!-- 4 Parts Right: Configuration Workspace (~57%) -->
            <ColumnDefinition Width="4*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Apps List Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Full-Width Search Bar -->
                <Border Grid.Row="0" Background="{DynamicResource InputBg}" CornerRadius="6" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Height="34">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtSearch" Grid.Column="1" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="{DynamicResource TextPrimary}" 
                                 FontSize="13" 
                                 Height="32"
                                 Padding="0"
                                 VerticalAlignment="Center"
                                 TextChanged="TxtSearch_TextChanged"
                                 KeyDown="TxtSearch_KeyDown"/>
                    </Grid>
                </Border>

                <!-- Group Filter Buttons -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                    <StackPanel x:Name="PanelGroups" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- Apps List with Auto-Scroll on Edge Drag -->
                <ListBox Grid.Row="2" x:Name="LstApps"
                         Background="Transparent"
                         BorderThickness="0"
                         AllowDrop="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="LstApps_PreviewMouseLeftButtonDown"
                         MouseMove="LstApps_MouseMove"
                         DragOver="LstApps_DragOver"
                         DragLeave="LstApps_DragLeave"
                         Drop="LstApps_Drop"
                         PreviewKeyDown="LstApps_PreviewKeyDown"
                         MouseDoubleClick="LstApps_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Background="{DynamicResource InputBg}" CornerRadius="6" Padding="10,8" Margin="0,2" Cursor="Hand">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🚀  Launch" Click="MenuLaunch_Click"/>
                                        <MenuItem Header="🛡️  Run as Administrator" Click="MenuRunAsAdmin_Click"/>
                                        <MenuItem Header="📂  Open File Location" Click="MenuOpenLocation_Click"/>
                                        <Separator Background="{DynamicResource BorderColor}"/>
                                        <MenuItem Header="🔤  Sort A → Z" Click="BtnSortAZ_Click"/>
                                        <Separator Background="{DynamicResource BorderColor}"/>
                                        <MenuItem Header="✏️  Edit Details &amp; Icon" Click="MenuEdit_Click"/>
                                        <MenuItem Header="🗑️  Delete" Click="MenuDelete_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding App.AppTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="↵" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBg}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock x:Name="TxtFooterCount" Text="0 Apps" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="Hold near top/bottom to auto-scroll list" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Right Panel: App Configuration (Wider Workspace: ~57%) -->
        <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="App Configuration" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                    <!-- App Title -->
                    <TextBlock Text="App Title" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,4"/>
                    <TextBox x:Name="TxtTitle"/>

                    <!-- Target / Location -->
                    <TextBlock Text="Target / Location" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPath" Grid.Column="0" TextChanged="TxtPath_TextChanged"/>
                        <Button Grid.Column="2" Content="Browse..." Click="BtnBrowseTarget_Click"/>
                    </Grid>

                    <!-- Arguments -->
                    <TextBlock Text="Arguments (optional)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,4"/>
                    <TextBox x:Name="TxtArgs"/>

                    <!-- Category / Group -->
                    <TextBlock Text="Category / Group (optional)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,4"/>
                    <TextBox x:Name="TxtGroup"/>

                    <!-- Standardized App Icon Section -->
                    <TextBlock Text="App Icon (optional)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Live Icon Preview -->
                        <Border Grid.Column="0" Width="32" Height="32" Background="{DynamicResource InputBg}" CornerRadius="6" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <Image x:Name="ImgIconPreview" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Custom Icon Path Box -->
                        <TextBox x:Name="TxtCustomIcon" Grid.Column="2" TextChanged="TxtCustomIcon_TextChanged"/>

                        <!-- Browse Button -->
                        <Button Grid.Column="4" Content="Browse..." Click="BtnBrowseIcon_Click"/>
                    </Grid>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Clear" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextSecondary}" Padding="16,0" Margin="0,0,8,0" Click="BtnClear_Click"/>
                        <Button x:Name="BtnSave" Content="Save App" Background="{DynamicResource AccentColor}" Foreground="White" Padding="18,0" Click="BtnSave_Click"/>
                    </StackPanel>

                    <Separator Background="{DynamicResource BorderColor}" Margin="0,16"/>

                    <!-- Preferences -->
                    <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbSystem" Content="System" Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0" Checked="RbTheme_Checked"/>
                        <RadioButton x:Name="RbDark" Content="Dark" Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0" Checked="RbTheme_Checked"/>
                        <RadioButton x:Name="RbLight" Content="Light" Foreground="{DynamicResource TextSecondary}" Checked="RbTheme_Checked"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkAutoStart" Content="Start with Windows (Minimized to Tray)" Foreground="{DynamicResource TextSecondary}" Click="ChkAutoStart_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
